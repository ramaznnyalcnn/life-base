# Flutter web build of the LifeBase app, served by nginx next to the API.
FROM ghcr.io/cirruslabs/flutter:3.38.5 AS build

WORKDIR /app/mobile
COPY mobile/pubspec.yaml mobile/pubspec.lock ./
RUN flutter pub get

COPY mobile /app/mobile
# CanvasKit is served from this origin, so the app needs no outside CDN.
RUN flutter build web --release --no-web-resources-cdn

FROM nginx:1.27-alpine

COPY infra/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/mobile/build/web /usr/share/nginx/html

EXPOSE 80
