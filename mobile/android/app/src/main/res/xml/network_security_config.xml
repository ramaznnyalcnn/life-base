<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The server is user-configured and may be an emulator or private LAN host. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
