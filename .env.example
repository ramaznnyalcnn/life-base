ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://lifeos:change-me@localhost:5432/lifeos
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me

SINGLE_USER_MODE=false
APP_API_TOKEN=
DEFAULT_OWNER_EMAIL=owner@example.com
DEFAULT_OWNER_NAME=Life OS Owner
DEFAULT_OWNER_PASSWORD=change-me-strong-owner-password

OPENROUTER_API_KEY=change-me
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
OPENROUTER_MODELS=stepfun/step-3.5-flash:free,arcee-ai/trinity-large-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WEB_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

ENABLE_WEB_PUSH=true
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:notify@example.com

REMINDER_DISPATCH_INTERVAL_SECONDS=60
REMINDER_DISPATCH_LIMIT=50
WEB_PORT=8080
VITE_API_BASE_URL=/api/v1
