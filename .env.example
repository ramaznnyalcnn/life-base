# Life OS example environment. Copy to .env and replace every placeholder before production use.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lifeos:lifeos@localhost:5432/lifeos
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for local single-user development. Set a strong value for protected deployments.
APP_API_TOKEN=
SINGLE_USER_MODE=true
DEFAULT_OWNER_EMAIL=owner@lifeos.local
DEFAULT_OWNER_NAME=Life OS Owner
DEFAULT_OWNER_PASSWORD=

# Optional AI parser integration.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
OPENROUTER_MODELS=stepfun/step-3.5-flash:free,arcee-ai/trinity-mini:free,openrouter/free

# Optional web push.
ENABLE_WEB_PUSH=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notify@example.com

REMINDER_DISPATCH_INTERVAL_SECONDS=60
REMINDER_DISPATCH_LIMIT=50

# Docker Compose defaults.
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me
WEB_PORT=8080
VITE_API_BASE_URL=/api/v1
